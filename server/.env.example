# Copy to .env and adjust. Real environment variables take precedence over .env.

# DuckDB file, absolute or relative to server/
HOTSPOTS_DB_PATH=data/hotspots.duckdb

# Comma-separated origins allowed by CORS (5173 = Vite client)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Pagination of /api/v1/hotspots
DEFAULT_LIMIT=10000
MAX_LIMIT=50000

# Used by run.py
API_HOST=127.0.0.1
API_PORT=5000
FLASK_DEBUG=0
