# Copy to .env and adjust. Real environment variables take precedence over .env.

# DuckDB file, absolute or relative to server/
HOTSPOTS_DB_PATH=data/hotspots.duckdb

# Comma-separated origins allowed by CORS (5173 = Vite client). Use * to allow any website.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# 1 = also allow any page served from this computer or the local network
# (192.168.x.x, 10.x.x.x, 172.16-31.x.x, *.local), so teammates can open the client from their devices
CORS_ALLOW_LAN=1

# Pagination of /api/v1/hotspots
DEFAULT_LIMIT=10000
MAX_LIMIT=50000

# Used by run.py. 0.0.0.0 = reachable from other devices on the LAN; 127.0.0.1 = this computer only
API_HOST=0.0.0.0
API_PORT=5000
FLASK_DEBUG=0
