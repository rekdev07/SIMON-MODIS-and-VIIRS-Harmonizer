      "item": [
        {
          "name": "Health",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Database connected\", () => pm.expect(pm.response.json()).to.eql({status: \"ok\", database: \"connected\"}));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "description": "200 when the database opens, 503 otherwise.",
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ],
              "query": []
            }
          },
          "response": []
        },
        {
          "name": "Dataset summary",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test(\"Has summary fields\", () => pm.expect(b).to.include.keys(\"total_records\",\"min_date\",\"max_date\",\"instruments\",\"bbox\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "description": "Total records, date range, count per instrument and bbox. Use it to pick valid dates.",
            "url": {
              "raw": "{{baseUrl}}/api/v1/dataset",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "dataset"
              ],
              "query": []
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Hotspots",
      "item": [
        {
          "name": "Yucatán, April 2013 (GeoJSON)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test(\"Is a FeatureCollection\", () => pm.expect(b.type).to.eql(\"FeatureCollection\"));",
                  "pm.test(\"Returns at most limit\", () => pm.expect(b.features.length).to.be.at.most(5));",
                  "pm.test(\"bbox is [min_lon, min_lat, max_lon, max_lat]\", () => pm.expect(b.metadata.bbox).to.eql([-90.4, 19.5, -87.4, 21.7]));",
                  "pm.test(\"Coordinates are [lon, lat] inside the box\", () => b.features.forEach(f => {",
                  "  const [lon, lat] = f.geometry.coordinates;",
                  "  pm.expect(lon).to.be.within(-90.4, -87.4); pm.expect(lat).to.be.within(19.5, 21.7);",
                  "}));",
                  "pm.test(\"No message when there are results\", () => { if (b.features.length) pm.expect(b).to.not.have.property(\"message\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "description": "Main search: rectangle + inclusive UTC dates. Corners can be in any order.",
            "url": {
              "raw": "{{baseUrl}}/api/v1/hotspots?lat1=21.7&lon1=-90.4&lat2=19.5&lon2=-87.4&start_date=2013-04-01&end_date=2013-04-30&limit=5",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "hotspots"
              ],
              "query": [
                {
                  "key": "lat1",
                  "value": "21.7"
                },
                {
                  "key": "lon1",
                  "value": "-90.4"
                },
                {
                  "key": "lat2",
                  "value": "19.5"
                },
                {
                  "key": "lon2",
                  "value": "-87.4"
                },
                {
                  "key": "start_date",
                  "value": "2013-04-01"
                },
                {
                  "key": "end_date",
                  "value": "2013-04-30"
                },
                {
                  "key": "limit",
                  "value": "5"
                }
              ]
            }
          },
          "response": []
        },
